# =========================================================
# DATABASE CONFIGURATION (PostgreSQL v18 Local / Neon DB)
# =========================================================
# Local PostgreSQL (Default Development)
DATABASE_URL="postgresql://postgres:a@localhost:5432/tifweb?schema=public"
DIRECT_URL="postgresql://postgres:a@localhost:5432/tifweb?schema=public"

# Contoh konfigurasi Neon DB (Gunakan saat menyambungkan ke Neon DB):
# DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/tifweb?sslmode=require"
# DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/tifweb?sslmode=require"

# =========================================================
# AUTH.JS CONFIGURATION
# =========================================================
AUTH_SECRET="ganti-dengan-secret-key-acak-anda"
AUTH_TRUST_HOST=true

# =========================================================
# CLOUDINARY CONFIGURATION
# =========================================================
CLOUDINARY_CLOUD_NAME="dvv4clp8"
CLOUDINARY_API_KEY="ganti-dengan-cloudinary-api-key"
CLOUDINARY_API_SECRET="ganti-dengan-cloudinary-api-secret"
CLOUDINARY_FOLDER="tifweb"
